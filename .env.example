# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wc2026?schema=public"

# ─── Redis ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://worldcupclutch.com"
# On Vercel this is automatically set — but set it explicitly so Server Components
# (e.g. OG image routes, sitemap) use the correct canonical origin.

# ─── Admin ──────────────────────────────────────────────
ADMIN_API_KEY="replace-with-long-random-admin-key"
SESSION_SECRET="replace-with-long-random-session-secret"
ADMIN_IP_ALLOWLIST=""

# ─── NextAuth v5 ────────────────────────────────────────
# Generate with:  openssl rand -base64 32
# On Vercel:  Settings → Environment Variables → AUTH_SECRET
AUTH_SECRET="replace-with-32-char-random-secret"
#
# NOTE: NextAuth v5 does NOT need NEXTAUTH_URL when trustHost: true is set
# (already configured in src/app/api/auth/config.ts). Do NOT add NEXTAUTH_URL
# to Vercel or it will conflict with the Vercel deployment URL.

# ─── Google OAuth ───────────────────────────────────────
# Setup steps:
#   1. Go to https://console.cloud.google.com/
#   2. APIs & Services → Credentials → Create OAuth 2.0 Client ID
#   3. Application type: Web application
#   4. Authorised JavaScript origins:
#        https://worldcupclutch.com
#   5. Authorised redirect URIs — ADD BOTH:
#        https://worldcupclutch.com/api/auth/callback/google
#        http://localhost:3000/api/auth/callback/google    (local dev)
#   6. Copy Client ID and Client Secret into Vercel env vars below
#
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Vercel env vars checklist ──────────────────────────
# Required for Google sign-in to work in production:
#
#   Variable name            Where to get it
#   ─────────────────────────────────────────────────────
#   DATABASE_URL             Vercel Postgres / Neon / Supabase dashboard
#   AUTH_SECRET              Run: openssl rand -base64 32
#   GOOGLE_CLIENT_ID         Google Cloud Console → Credentials
#   GOOGLE_CLIENT_SECRET     Google Cloud Console → Credentials
#   NEXT_PUBLIC_SITE_URL     https://worldcupclutch.com
#
# In Vercel: Project → Settings → Environment Variables → Add each one above.
# After adding ALL variables, trigger a new deployment (push a commit or
# use "Redeploy" in the Vercel dashboard).
#
# Common mistake: the Google Cloud Console redirect URI must be EXACTLY
#   https://worldcupclutch.com/api/auth/callback/google
# (no trailing slash, correct path). A mismatch causes the 404 on login.
