# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wc2026?schema=public"

# ─── Redis ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Admin ──────────────────────────────────────────────
ADMIN_API_KEY="replace-with-long-random-admin-key"
SESSION_SECRET="replace-with-long-random-session-secret"
ADMIN_IP_ALLOWLIST=""

# ─── NextAuth ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-32-char-random-secret"

# ─── Google OAuth ───────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 4. Application type: Web application
# 5. Authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google   (dev)
#    - https://worldcupclutch.com/api/auth/callback/google  (prod)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
