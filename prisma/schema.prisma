generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum MatchStage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  EXTRA_TIME
  PENALTIES
  FINISHED
  POSTPONED
  CANCELED
}

enum PredictionStatus {
  COMING_SOON
  OPEN
  LOCKED
  SCORED
}

enum TeamSlotKind {
  TEAM
  GROUP_PLACEHOLDER
  BRACKET_PLACEHOLDER
}

enum EventType {
  KICKOFF
  GOAL
  OWN_GOAL
  PENALTY_AWARDED
  PENALTY_SCORED
  PENALTY_MISSED
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  VAR_CHECK
  VAR_OVERTURN
  INJURY_TIME
  HALF_TIME
  FULL_TIME
}

enum WindowStatus {
  SCHEDULED
  OPEN
  LOCKED
  SCORED
}

enum PredictionKind {
  MATCH_WINNER
  NEXT_GOAL_TEAM
  BOTH_TEAMS_SCORE
  TOTAL_GOALS_OVER_UNDER
  FIRST_CARD_TEAM
  CLEAN_SHEET
  PENALTY_IN_MATCH
  UPSET_PICK
}

enum LeaderboardPeriod {
  DAILY
  MATCHDAY
  TOURNAMENT
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

// ─── NextAuth Models ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ─────────────────────────────────────────

model Team {
  id            String     @id @default(cuid())
  fifaCode      String     @unique
  name          String
  slug          String     @unique
  confederation String?
  isQualified   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  slots         TeamSlot[]
}

model Stadium {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String
  country   String
  timezone  String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matches   Match[]
}

model TeamSlot {
  id                 String       @id @default(cuid())
  kind               TeamSlotKind
  label              String
  groupCode          String?
  groupPosition      Int?
  sourceMatchId      String?
  sourceMatchOutcome String?
  teamId             String?
  resolvedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  team               Team?        @relation(fields: [teamId], references: [id])
  homeMatches        Match[]      @relation("HomeSlot")
  awayMatches        Match[]      @relation("AwaySlot")

  @@index([kind, groupCode, groupPosition])
  @@index([sourceMatchId])
}

model Match {
  id                 String           @id @default(cuid())
  externalId         String?          @unique
  slug               String           @unique
  stage              MatchStage
  matchNumber        Int              @unique
  kickoffUtc         DateTime
  kickoffTimezone    String
  status             MatchStatus      @default(SCHEDULED)
  predictionStatus   PredictionStatus @default(COMING_SOON)
  stadiumId          String
  homeSlotId         String
  awaySlotId         String
  homeScore          Int              @default(0)
  awayScore          Int              @default(0)
  homeScorePenalties Int?
  awayScorePenalties Int?
  minute             Int?
  second             Int?
  stoppageMinute     Int?
  oddsHomeWin        Decimal?         @db.Decimal(8, 3)
  oddsDraw           Decimal?         @db.Decimal(8, 3)
  oddsAwayWin        Decimal?         @db.Decimal(8, 3)
  statsJson          Json?
  lineupJson         Json?
  lastEventAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  stadium            Stadium          @relation(fields: [stadiumId], references: [id])
  homeSlot           TeamSlot         @relation("HomeSlot", fields: [homeSlotId], references: [id])
  awaySlot           TeamSlot         @relation("AwaySlot", fields: [awaySlotId], references: [id])
  events             MatchEvent[]
  windows            PredictionWindow[]

  @@index([kickoffUtc])
  @@index([stage, kickoffUtc])
  @@index([status, kickoffUtc])
  @@index([predictionStatus, kickoffUtc])
}

model MatchEvent {
  id             String    @id @default(cuid())
  matchId        String
  sequence       Int
  minute         Int?
  second         Int?
  stoppageMinute Int?
  type           EventType
  teamSlotId     String?
  playerName     String?
  assistName     String?
  subject        String?
  payload        Json?
  createdAt      DateTime  @default(now())
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@index([matchId, createdAt])
}

model PredictionWindow {
  id              String         @id @default(cuid())
  matchId         String
  kind            PredictionKind
  title           String
  openAt          DateTime
  lockAt          DateTime
  resolveAt       DateTime?
  status          WindowStatus   @default(SCHEDULED)
  scoringRuleJson Json
  weight          Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  match           Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  picks           UserPick[]

  @@index([matchId, status])
  @@index([openAt, lockAt])
  @@index([kind, status])
}

model User {
  id            String    @id @default(cuid())
  // NextAuth fields
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // App fields
  username      String?   @unique
  role          UserRole  @default(USER)
  points        Int       @default(0)
  xp            Int       @default(0)
  streakCurrent Int       @default(0)
  streakBest    Int       @default(0)
  bannedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Relations
  accounts      Account[]
  sessions      Session[]
  picks         UserPick[]
  awards        UserAward[]
}

model UserPick {
  id                 String           @id @default(cuid())
  userId             String
  predictionWindowId String
  choice             String
  confidence         Int?
  submittedAt        DateTime         @default(now())
  scoredAt           DateTime?
  pointsAwarded      Int              @default(0)
  isCorrect          Boolean?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  window             PredictionWindow @relation(fields: [predictionWindowId], references: [id], onDelete: Cascade)

  @@unique([userId, predictionWindowId])
  @@index([predictionWindowId, submittedAt])
  @@index([userId, scoredAt])
}

model LeaderboardSnapshot {
  id        String            @id @default(cuid())
  period    LeaderboardPeriod
  periodKey String
  rank      Int
  userId    String
  points    Int
  xp        Int
  createdAt DateTime          @default(now())

  @@index([period, periodKey, rank])
  @@index([userId, period, createdAt])
}

model UserAward {
  id          String   @id @default(cuid())
  userId      String
  badgeCode   String
  title       String
  description String?
  awardedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, awardedAt])
  @@unique([userId, badgeCode])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String
  note        String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([adminUserId, createdAt])
}